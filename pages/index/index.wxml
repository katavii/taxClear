<page-meta page-style="{{ showInsureModal || showSpecialModal ? 'overflow: hidden; height: 100%;' : '' }}" />
<view class="page tab-page">
  <immersive-header
    title="工资薪金所得税"
    subtitle="综合所得 · 七级超额累进税率 3%-45%"
  />

  <view class="mode-switch">
    <view
      class="mode-switch-item {{calcMode === 'yearly' ? 'active' : ''}}"
      data-mode="yearly"
      bindtap="onModeChange"
      hover-class="mode-switch-item--pressed"
    >
      <text class="mode-switch-label">全年个税计算</text>
      <text class="mode-switch-desc">年薪+年终奖</text>
    </view>
    <view
      class="mode-switch-item {{calcMode === 'monthly' ? 'active' : ''}}"
      data-mode="monthly"
      bindtap="onModeChange"
      hover-class="mode-switch-item--pressed"
    >
      <text class="mode-switch-label">月度个税计算</text>
      <text class="mode-switch-desc">累计预扣预缴</text>
    </view>
  </view>

  <view class="card card--flat">
    <view class="card-section">
      <view class="card-header">
        <view class="card-header-main">
          <view class="card-header-icon-wrap">
            <van-icon name="gold-coin-o" size="32rpx" color="#2563EB" />
          </view>
          <text class="card-header-title">收入</text>
        </view>
      </view>
    </view>
    <van-cell-group border="{{false}}">
      <block wx:if="{{calcMode === 'monthly'}}">
        <picker mode="selector" range="{{monthOptions}}" value="{{month - 1}}" bindchange="onMonthChange">
          <van-cell title="计税所属月份" value="{{month}}月" is-link title-width="7.5em" />
        </picker>
        <van-field
          label="税前月工资"
          type="digit"
          placeholder="如：15000"
          value="{{monthlySalary}}"
          data-field="monthlySalary"
          bind:change="onInput"
          title-width="7.5em"
        />
        <van-field
          label="其他税前扣除"
          type="digit"
          placeholder="企业年金、职业年金、商业健康险、税延养老保险"
          value="{{monthlyOtherDeduct}}"
          data-field="monthlyOtherDeduct"
          bind:change="onInput"
          title-width="7.5em"
        />
        <van-field
          label="累计已预缴税额"
          type="digit"
          placeholder="留空则按前月自动推算"
          value="{{monthlyPaidTax}}"
          data-field="monthlyPaidTax"
          bind:change="onInput"
          title-width="7.5em"
          label-class="field-label--optional"
        />
      </block>
      <block wx:else>
        <van-field
          label="全年税前工资"
          type="digit"
          placeholder="不含年终奖，如：180000"
          value="{{yearSalary}}"
          data-field="yearSalary"
          bind:change="onInput"
          title-width="7.5em"
        />
        <van-field
          label="年终奖收入"
          type="digit"
          placeholder="如：30000"
          value="{{yearBonus}}"
          data-field="yearBonus"
          bind:change="onInput"
          title-width="7.5em"
        />
        <van-field
          label="其他税前扣除"
          type="digit"
          placeholder="按月填写，自动×12"
          value="{{monthlyOtherDeduct}}"
          data-field="monthlyOtherDeduct"
          bind:change="onInput"
          title-width="7.5em"
          label-class="field-label--optional"
        />
      </block>
    </van-cell-group>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-header-main">
        <view class="card-header-icon-wrap">
          <van-icon name="shield-o" size="32rpx" color="#2563EB" />
        </view>
        <text class="card-header-title">五险一金缴纳</text>
      </view>
      <view class="card-header-action">
        <view class="quick-btn" hover-class="quick-btn--pressed" bindtap="openInsureModal">
          <van-icon name="records-o" size="28rpx" color="#2563EB" />
          <text>快速计算</text>
        </view>
      </view>
    </view>
    <view class="deduct-panel" hover-class="deduct-panel--pressed" bindtap="openInsureModal">
      <view class="deduct-amount {{monthlyInsure ? '' : 'is-empty'}}">{{insureSummary}}</view>
      <view class="deduct-hint">个人缴纳部分（养老、医疗、失业、公积金）{{calcMode === 'yearly' ? '· 按年自动汇总' : ''}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-header-main">
        <view class="card-header-icon-wrap">
          <van-icon name="orders-o" size="32rpx" color="#2563EB" />
        </view>
        <text class="card-header-title">专项附加扣除</text>
      </view>
      <view class="card-header-action">
        <view class="quick-btn" hover-class="quick-btn--pressed" bindtap="openSpecialModal">
          <van-icon name="records-o" size="28rpx" color="#2563EB" />
          <text>快速计算</text>
        </view>
      </view>
    </view>
    <view class="deduct-panel">
      <view class="deduct-amount {{monthlySpecialAdd > 0 ? '' : 'is-empty'}}">{{specialAddSummary}}</view>
      <view class="deduct-hint">勾选符合的项目，自动累加月度/年度扣除额</view>
    </view>
  </view>

  <view class="nav-grid">
    <view class="nav-item" hover-class="nav-item--pressed" data-url="/pages/bonus/bonus" bindtap="goPage">
      <view class="nav-item-icon">
        <van-icon name="gift-o" size="36rpx" color="#2563EB" />
      </view>
      <view class="nav-item-title">年终奖计算</view>
      <view class="nav-item-desc">单独计税 vs 合并计税</view>
    </view>
    <view class="nav-item" hover-class="nav-item--pressed" data-url="/pages/annual/annual" bindtap="goPage">
      <view class="nav-item-icon">
        <van-icon name="calendar-o" size="36rpx" color="#2563EB" />
      </view>
      <view class="nav-item-title">年度汇算</view>
      <view class="nav-item-desc">补税/退税测算</view>
    </view>
    <view class="nav-item nav-item--full" hover-class="nav-item--pressed" data-url="/pages/labor/labor" bindtap="goPage">
      <view class="nav-item-icon">
        <van-icon name="user-o" size="36rpx" color="#2563EB" />
      </view>
      <view class="nav-item-title">劳务报酬</view>
      <view class="nav-item-desc">自由职业者专用</view>
    </view>
  </view>

  <view class="btn-group">
    <van-button type="primary" block round custom-class="btn-primary" bind:click="onCalc">立即计算</van-button>
    <van-button plain block round custom-class="reset-btn" bind:click="onReset">重置</van-button>
  </view>

  <view class="card result-card" id="calc-result" wx:if="{{showResult && result}}">
    <block wx:if="{{calcMode === 'monthly'}}">
      <view class="result-hero">
        <text class="result-hero-label">税后到手工资</text>
        <text class="result-hero-value">¥{{result.afterTaxSalary}}</text>
      </view>
      <view class="result-title">计算明细</view>
      <view class="result-row">
        <text>本月应缴个税</text>
        <text class="result-value">¥{{result.currentMonthTax}}</text>
      </view>
      <view class="result-row" wx:if="{{result.autoPaidTax}}">
        <text>累计已缴税额</text>
        <text class="result-value">¥{{result.totalPaidTax}}（自动推算）</text>
      </view>
      <view class="result-row">
        <text>专项附加扣除(月)</text>
        <text class="result-value">¥{{result.monthlySpecialAdd}}</text>
      </view>
      <view class="result-row">
        <text>累计应纳税所得额</text>
        <text class="result-value">¥{{result.taxableIncome}}</text>
      </view>
      <view class="result-row">
        <text>适用税率档位</text>
        <text class="result-value">{{result.taxLevel || result.tip}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="result-hero">
        <text class="result-hero-label">税后到手收入</text>
        <text class="result-hero-value">¥{{result.afterTaxIncome}}</text>
      </view>

      <view class="result-block">
        <view class="result-block-title">收入明细</view>
        <view class="result-row result-row--in-block">
          <text>全年税前收入</text>
          <text class="result-value">¥{{result.totalIncome}}</text>
        </view>
      </view>

      <view class="result-block result-block--deduct">
        <view class="result-block-title">扣除明细</view>
        <view class="result-row-group result-row-group--deduct">
          <view class="result-row result-row--inner">
            <text>基本减除费用</text>
            <text class="result-value">-¥{{result.baseDeduction}}</text>
          </view>
          <text class="result-hint">5000元/月 × 12个月</text>
        </view>
        <view class="result-row result-row--in-block result-row--deduct">
          <text>五险一金扣除</text>
          <text class="result-value">-¥{{result.yearInsure}}</text>
        </view>
        <view class="result-row result-row--in-block result-row--deduct">
          <text>专项扣除</text>
          <text class="result-value">-¥{{result.yearSpecialAdd}}</text>
        </view>
        <view class="result-row result-row--in-block result-row--deduct" wx:if="{{result.yearOtherDeduct > 0}}">
          <text>其他税前扣除</text>
          <text class="result-value">-¥{{result.yearOtherDeduct}}</text>
        </view>
      </view>

      <view class="result-block result-block--summary">
        <view class="result-block-title">税额测算</view>
        <view class="result-row result-row--in-block">
          <text>应纳税所得额</text>
          <text class="result-value">¥{{result.taxableIncome}}</text>
        </view>
        <view class="result-row result-row--in-block result-row--highlight">
          <text>全年应缴个人所得税</text>
          <text class="result-value highlight">¥{{result.totalTax}}</text>
        </view>
        <view class="result-row result-row--in-block">
          <text>综合税率</text>
          <text class="result-value">{{result.marginalRateText}}</text>
        </view>
        <view class="result-row result-row--in-block">
          <text>实际税率</text>
          <text class="result-value">{{result.effectiveRateText}}</text>
        </view>
        <view class="result-row result-row--in-block result-row--final">
          <text>税后到手收入</text>
          <text class="result-value">¥{{result.afterTaxIncome}}</text>
        </view>
      </view>

      <view class="result-block result-block--bonus" wx:if="{{result.bonusAmount > 0}}">
        <view class="result-block-title">年终奖计税方案</view>
        <view class="result-row result-row--in-block">
          <text>推荐方式</text>
          <text class="result-value">{{result.bestMode}}</text>
        </view>
        <view class="result-row result-row--in-block">
          <text>单独计税（工资税+奖金税）</text>
          <text class="result-value">¥{{result.separateTotalTax}}</text>
        </view>
        <view class="result-row result-row--in-block">
          <text>年终奖单独税额</text>
          <text class="result-value">¥{{result.bonusSingleTax}}</text>
        </view>
        <view class="result-row result-row--in-block">
          <text>并入综合所得（全年总税）</text>
          <text class="result-value">¥{{result.mergeTotalTax}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="disclaimer">测算结果仅供参考，最终数据以国家税务总局官方系统为准</view>
</view>

<!-- 五险一金快速计算 -->
<van-popup
  show="{{showInsureModal}}"
  position="bottom"
  round
  closeable
  lock-scroll
  z-index="10050"
  bind:close="closeInsureModal"
>
  <view class="modal-sheet">
    <view class="modal-handle" />
    <view class="modal-title">五险一金快速计算</view>
    <view class="modal-desc">输入月缴费基数与各险种比例，自动计算月缴总额</view>

    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{true}}" enable-flex class="modal-scroll">
      <view class="modal-scroll-body">
      <view class="modal-field">
        <view class="modal-label">社保缴费基数（月）</view>
        <van-field
          type="digit"
          placeholder="¥ 0 /月"
          value="{{insureBase}}"
          bind:change="onInsureBaseInput"
          border="{{false}}"
          custom-class="modal-input"
        />
      </view>

      <view class="insure-item">
        <view class="insure-item-head">
          <view class="insure-item-title">
            <text class="insure-name">养老保险</text>
            <text class="insure-tag">已固定</text>
          </view>
          <text class="insure-rate">个人 8%</text>
        </view>
        <text class="insure-amount">¥ {{insureDetail.pension}}/月</text>
      </view>

      <view class="insure-item">
        <view class="insure-item-head">
          <view class="insure-item-title">
            <text class="insure-name">医疗保险</text>
            <text class="insure-tag">已固定</text>
          </view>
          <text class="insure-rate">个人 2%</text>
        </view>
        <text class="insure-amount">¥ {{insureDetail.medical}}/月</text>
      </view>

      <view class="insure-item">
        <view class="insure-item-head">
          <view class="insure-item-title">
            <text class="insure-name">失业保险</text>
            <text class="insure-tag">已固定</text>
          </view>
          <text class="insure-rate">个人 0.5%</text>
        </view>
        <text class="insure-amount">¥ {{insureDetail.unemployment}}/月</text>
      </view>

      <view class="insure-item insure-item--with-slider">
        <view class="insure-item-head">
          <text class="insure-name">住房公积金</text>
          <text class="insure-rate">个人 {{housingFundPercent}}%</text>
        </view>
        <van-slider
          min="5"
          max="12"
          step="1"
          value="{{housingFundPercent}}"
          active-color="#2563EB"
          inactive-color="#E2E8F0"
          bind:change="onHousingFundChange"
          bind:drag="onHousingFundChange"
        />
        <text class="insure-amount">¥ {{insureDetail.housingFund}}/月</text>
      </view>
      </view>
    </scroll-view>

    <view class="modal-total">
      <text>月缴合计</text>
      <text class="modal-total-value">¥ {{insureDetail.total}}/月</text>
    </view>

    <view class="modal-actions">
      <van-button type="primary" block round custom-class="btn-primary" bind:click="confirmInsureModal">确认填入</van-button>
    </view>
  </view>
</van-popup>

<!-- 专项附加扣除快速计算 -->
<van-popup
  show="{{showSpecialModal}}"
  position="bottom"
  round
  closeable
  lock-scroll
  z-index="10050"
  bind:close="closeSpecialModal"
>
  <view class="modal-sheet">
    <view class="modal-handle" />
    <view class="modal-title">专项附加扣除快速计算</view>
    <view class="modal-desc">勾选您符合的项目，自动累加年度扣除额</view>

    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{true}}" enable-flex class="special-scroll">
      <view class="modal-scroll-body">
      <view class="special-item">
        <view class="special-item-info">
          <text class="special-name">子女教育</text>
          <text class="special-rule">¥12,000/年·孩</text>
        </view>
        <van-stepper
          value="{{specialDraft.childEduCount}}"
          min="0"
          max="10"
          data-field="childEduCount"
          bind:change="onSpecialStepper"
        />
      </view>

      <view class="special-item">
        <view class="special-item-info">
          <text class="special-name">3岁以下婴幼儿照护</text>
          <text class="special-rule">¥12,000/年·孩</text>
        </view>
        <van-stepper
          value="{{specialDraft.babyCareCount}}"
          min="0"
          max="10"
          data-field="babyCareCount"
          bind:change="onSpecialStepper"
        />
      </view>

      <view class="special-item special-item-block">
        <view class="special-item-info">
          <text class="special-name">继续教育</text>
          <text class="special-rule">学历 ¥4,800/年 · 职业资格 ¥3,600/年</text>
        </view>
        <view class="option-group">
          <view
            wx:for="{{continuingEduOptions}}"
            wx:key="value"
            class="option-chip {{specialDraft.continuingEduType === item.value ? 'active' : ''}}"
            hover-class="option-chip--pressed"
            data-field="continuingEduType"
            data-value="{{item.value}}"
            bindtap="onSpecialOptionTap"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="special-item">
        <view class="special-item-info">
          <text class="special-name">住房贷款利息</text>
          <text class="special-rule">¥12,000/年 · 首套</text>
        </view>
        <van-switch
          checked="{{specialDraft.hasHouseLoan}}"
          size="24px"
          active-color="#2563EB"
          bind:change="onSpecialSwitch"
        />
      </view>

      <view class="special-item special-item-block">
        <view class="special-item-info">
          <text class="special-name">住房租金</text>
          <text class="special-rule">¥9,600~18,000/年 · 分城市等级</text>
        </view>
        <view class="option-group">
          <view
            wx:for="{{rentOptions}}"
            wx:key="value"
            class="option-chip {{specialDraft.rentLevel === item.value ? 'active' : ''}}"
            hover-class="option-chip--pressed"
            data-field="rentLevel"
            data-value="{{item.value}}"
            bindtap="onSpecialOptionTap"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="special-item special-item-block">
        <view class="special-item-info">
          <text class="special-name">赡养老人</text>
          <text class="special-rule">独生子女 ¥36,000/年 · 非独生子女分摊上限 ¥18,000/年</text>
        </view>
        <view class="option-group">
          <view
            wx:for="{{elderOptions}}"
            wx:key="value"
            class="option-chip {{specialDraft.supportElderType === item.value ? 'active' : ''}}"
            hover-class="option-chip--pressed"
            data-field="supportElderType"
            data-value="{{item.value}}"
            bindtap="onSpecialOptionTap"
          >{{item.name}}</view>
        </view>
      </view>
      </view>
    </scroll-view>

    <view class="modal-total special-total">
      <text>年度专项附加扣除合计</text>
      <text class="modal-total-value">¥ {{specialDraftAnnual}}/年</text>
    </view>

    <view class="modal-actions">
      <van-button type="primary" block round custom-class="btn-primary" bind:click="confirmSpecialModal">确认填入</van-button>
    </view>
  </view>
</van-popup>

<van-toast id="van-toast" />
