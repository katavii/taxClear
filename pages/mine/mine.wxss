.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.login-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.login-tip {
  font-size: 28rpx;
  color: #999999;
}
