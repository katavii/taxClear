<view class="container tab-page">
  <view class="page-title">个税计算器 · 帮助中心</view>
  <view class="seo-intro">个税计算器说明、个人所得税税率表与专项附加扣除标准，测算结果仅供参考。</view>

  <view class="card">
    <view class="section-title">常见问题</view>
    <view class="faq-list">
      <view class="faq-item" wx:for="{{faqList}}" wx:key="q">
        <view class="faq-q">{{item.q}}</view>
        <view class="faq-a">{{item.a}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">综合所得税率表（累计预扣）</view>
    <view class="table-header">
      <text>级数</text>
      <text>累计应纳税所得额</text>
      <text>税率</text>
    </view>
    <view class="table-row" wx:for="{{salaryTable}}" wx:key="min">
      <text>{{index + 1}}</text>
      <text>{{item.min}}~{{item.maxDisplay}}</text>
      <text>{{item.rate * 100}}%</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">年终奖单独计税税率表</view>
    <view class="table-header">
      <text>级数</text>
      <text>月基数范围</text>
      <text>税率</text>
    </view>
    <view class="table-row" wx:for="{{bonusTable}}" wx:key="min">
      <text>{{index + 1}}</text>
      <text>{{item.min}}~{{item.maxDisplay}}</text>
      <text>{{item.rate * 100}}%</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">专项附加扣除标准（2026）</view>
    <van-cell-group>
      <van-cell wx:for="{{deductList}}" wx:key="name" title="{{item.name}}" label="{{item.standard}}" />
    </van-cell-group>
  </view>

  <view class="disclaimer">测算结果仅供参考，最终数据以国家税务总局官方系统为准</view>
</view>
