.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.faq-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.faq-q {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.faq-a {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
}

.table-header,
.table-row {
  display: flex;
  font-size: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-header {
  font-weight: 600;
  color: #666666;
}

.table-header text,
.table-row text {
  flex: 1;
  text-align: center;
}

.table-row text:first-child {
  flex: 0.5;
}
