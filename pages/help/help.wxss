.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.table-header,
.table-row {
  display: flex;
  font-size: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-header {
  font-weight: 600;
  color: #666666;
}

.table-header text,
.table-row text {
  flex: 1;
  text-align: center;
}

.table-row text:first-child {
  flex: 0.5;
}
