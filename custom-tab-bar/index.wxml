<view class="tab-bar" wx:if="{{show}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar-item {{selected === index ? 'tab-bar-item--active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tab-bar-item--pressed"
    hover-stay-time="80"
  >
    <view class="tab-bar-item-icon">
      <van-icon
        name="{{item.icon}}"
        size="40rpx"
        color="{{selected === index ? selectedColor : color}}"
      />
    </view>
    <text class="tab-bar-item-text">{{item.text}}</text>
  </view>
</view>
