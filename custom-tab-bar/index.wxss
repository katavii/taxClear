.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  align-items: stretch;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 0 16rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #f1f5f9;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 108rpx;
  padding-top: 4rpx;
  transition: opacity 0.2s ease;
}

.tab-bar-item--pressed {
  opacity: 0.72;
}

.tab-bar-item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 44rpx;
  border-radius: 22rpx;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.tab-bar-item--active .tab-bar-item-icon {
  background: #eff6ff;
}

.tab-bar-item-text {
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 500;
  color: #94a3b8;
  letter-spacing: 0.2rpx;
}

.tab-bar-item--active .tab-bar-item-text {
  font-weight: 600;
  color: #2563eb;
}
